{
  "name": "@neutron-ai/cli",
  "version": "0.3.0",
  "private": false,
  "description": "Cross-platform command line interface for Neutron AI memory and MCP operations.",
  "license": "Apache-2.0",
  "homepage": "https://neutronai.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neutronai-dev/sdk-js.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/neutronai-dev/sdk-js/issues"
  },
  "keywords": ["neutron-ai", "memory", "mcp", "agents", "cli"],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "neutron": "./dist/bin/neutron.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test"
  },
  "dependencies": {
    "@neutron-ai/sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  }
}
